{
  "name": "vue-aify",
  "version": "0.1.1",
  "description": "AI-native control layer for GUI: a structured page/action graph with fixed operations (Web + Desktop isomorphic).",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vue": "^3.4.0"
  },
  "allowScripts": ["esbuild", "vue-demi"]
}
